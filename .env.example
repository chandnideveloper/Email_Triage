# =====================================================================
# Microsoft Entra ID (Azure AD) & Microsoft Graph API Settings
# =====================================================================
# Azure App Registration Credentials
GRAPH_CLIENT_ID=00000000-0000-0000-0000-000000000000
GRAPH_CLIENT_SECRET=replace_with_client_secret_value
GRAPH_TENANT_ID=00000000-0000-0000-0000-000000000000
GRAPH_AUTHORITY_HOST=https://login.microsoftonline.com

# Target Mailbox to Ingest (UPN or user object ID)
# e.g., triage@yourpractice.com.au or shared-inbox@yourpractice.com.au
TARGET_MAILBOX=triage@example.com

# Graph Scopes for Application Permission: https://graph.microsoft.com/.default
GRAPH_SCOPES=https://graph.microsoft.com/.default
GRAPH_API_BASE=https://graph.microsoft.com/v1.0

# =====================================================================
# Celery & Redis Task Queue Configuration
# =====================================================================
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
# Run tasks synchronously in memory if Celery/Redis is not running (True for test/dev)
TASK_ALWAYS_EAGER=True

# =====================================================================
# Webhook Configuration
# =====================================================================
# Publicly accessible notification URL where Microsoft Graph posts events
# (must be HTTPS in production, e.g. ngrok or reverse proxy in development)
WEBHOOK_NOTIFICATION_URL=https://triage.yourpractice.com.au/api/triage/webhook
# Secret token shared with Microsoft Graph to validate notification authenticity
WEBHOOK_CLIENT_STATE=change-this-to-a-cryptographically-secure-random-token
# Subscription validity period in minutes (max 4230 minutes = ~3 days for mail)
WEBHOOK_SUBSCRIPTION_MINUTES=4200

# =====================================================================
# Ingestion & Attachment Storage Settings
# =====================================================================
EMAIL_BATCH_SIZE=50
MAX_ATTACHMENT_SIZE_BYTES=26214400 # 25 MB
ALLOWED_ATTACHMENT_EXTENSIONS=.pdf,.docx,.xlsx,.csv,.txt,.png,.jpg,.jpeg
ATTACHMENT_STORAGE_DIR=./storage_data/attachments
REPOSITORY_STORAGE_PATH=./storage_data/triage_store.json

# =====================================================================
# Security & Logging
# =====================================================================
LOG_LEVEL=INFO
# Never log raw email bodies or confidential tokens
SANITIZE_LOGS=True
READINESS_ENV=development
